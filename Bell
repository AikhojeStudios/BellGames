<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Play & Learn</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#16324F; --paper:#FFFDF7; --gold:#FFC93C; --gold-deep:#E5A413;
    --green:#3FBF6A; --green-deep:#2E9A50; --coral:#FF7A59; --coral-deep:#E25636;
    --sky:#79CDEA; --sky-deep:#4FB0D6; --mint:#A7E8C8; --purple:#7C5CD6; --purple-deep:#5E3FBE;
    --shadow:rgba(22,50,79,.18);
  }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
  html,body{height:100%;margin:0;}
  body{
    font-family:'Nunito',system-ui,sans-serif;color:var(--ink);
    background:linear-gradient(170deg,var(--sky) 0%,var(--mint) 100%);
    display:flex;justify-content:center;align-items:flex-start;
    min-height:100%;padding:14px;overflow-x:hidden;
  }
  .screen{display:none;width:100%;max-width:480px;flex-direction:column;gap:12px;}
  .screen.active{display:flex;}
  .eyebrow{font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:#8AA0B4;}

  /* ---------------- HUB ---------------- */
  .hubhead{text-align:center;padding:8px 0 2px;}
  .hubhead .sun{font-size:40px;line-height:1;}
  .hubhead h1{font-family:'Fredoka';font-weight:700;font-size:34px;margin:6px 0 2px;color:var(--ink);}
  .hubhead p{margin:0;font-weight:700;color:#3E6B7E;}
  .tiles{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
  .tile{position:relative;border:none;cursor:pointer;text-align:left;background:var(--paper);border-radius:24px;padding:14px;box-shadow:0 7px 0 var(--shadow);display:flex;flex-direction:column;gap:10px;min-height:168px;transition:transform .08s,box-shadow .08s;}
  .tile:active{transform:translateY(4px);box-shadow:0 3px 0 var(--shadow);}
  .tileart{height:86px;border-radius:18px;display:flex;align-items:center;justify-content:center;background:linear-gradient(160deg,#FFF3CE,#FFE49A);position:relative;overflow:hidden;}
  .tileart img{width:56px;height:56px;filter:drop-shadow(0 3px 2px rgba(22,50,79,.25));}
  .tileart img+img{margin-left:-22px;}
  .tiletext{display:flex;flex-direction:column;gap:1px;}
  .tiletext .tt{font-family:'Fredoka';font-weight:600;font-size:21px;line-height:1.05;color:var(--ink);}
  .tiletext .ts{font-weight:800;font-size:12.5px;color:#8AA0B4;}
  .tile.soon{cursor:default;background:#EAF1F4;box-shadow:0 6px 0 rgba(22,50,79,.1);}
  .tile.soon:active{transform:none;box-shadow:0 6px 0 rgba(22,50,79,.1);}
  .tile.soon .tileart{background:#DCE7EC;}
  .soonart{font-size:40px;opacity:.55;}
  .tile.soon .tt,.tile.soon .ts{color:#9DB0BC;}
  .ribbon{position:absolute;top:12px;right:-2px;background:var(--purple);color:#fff;font-family:'Fredoka';font-weight:600;font-size:12px;padding:3px 12px;border-radius:8px 0 0 8px;box-shadow:0 3px 0 var(--purple-deep);}

  /* ---------------- MODE SELECT ---------------- */
  .subhead{display:flex;align-items:center;gap:12px;background:var(--paper);border-radius:20px;padding:10px 12px;box-shadow:0 6px 0 var(--shadow);}
  .subhead .name{font-family:'Fredoka';font-weight:600;font-size:21px;line-height:1;color:var(--ink);}
  .modecards{display:flex;flex-direction:column;gap:12px;}
  .modecard{position:relative;border:none;cursor:pointer;text-align:left;background:var(--paper);border-radius:22px;padding:14px;box-shadow:0 7px 0 var(--shadow);display:flex;align-items:center;gap:14px;transition:transform .08s,box-shadow .08s;border-left:10px solid var(--green);}
  .modecard.medium{border-left-color:var(--gold-deep);}
  .modecard.hard{border-left-color:var(--coral-deep);}
  .modecard:active{transform:translateY(4px);box-shadow:0 3px 0 var(--shadow);}
  .mcoins{display:flex;align-items:center;flex:none;}
  .mcoins img{width:42px;height:42px;filter:drop-shadow(0 2px 1px rgba(22,50,79,.2));}
  .mcoins img+img{margin-left:-16px;}
  .mtext{flex:1;display:flex;flex-direction:column;gap:1px;}
  .mtext .ml{font-family:'Fredoka';font-weight:600;font-size:23px;line-height:1;color:var(--ink);}
  .mtext .mt{font-weight:800;font-size:13px;color:#8AA0B4;}
  .modecard .go{font-size:20px;color:#B9C6D1;flex:none;}

  /* ---------------- GAME ---------------- */
  .topbar{display:flex;align-items:center;gap:10px;background:var(--paper);border-radius:20px;padding:10px 12px;box-shadow:0 6px 0 var(--shadow);}
  .iconbtn{flex:none;width:44px;height:44px;border:none;border-radius:14px;cursor:pointer;background:#EDF3F6;color:var(--ink);font-size:20px;box-shadow:0 4px 0 #CDD9E0;transition:transform .08s,box-shadow .08s;}
  .iconbtn:active{transform:translateY(3px);box-shadow:0 1px 0 #CDD9E0;}
  .diffchip{flex:1;min-width:0;border:none;cursor:pointer;background:#F3F7F9;border-radius:16px;padding:7px 12px;text-align:left;box-shadow:0 4px 0 #D8E2E7;transition:transform .08s,box-shadow .08s;}
  .diffchip:active{transform:translateY(3px);box-shadow:0 1px 0 #D8E2E7;}
  .diffchip .dl{font-family:'Fredoka';font-weight:600;font-size:17px;line-height:1;display:flex;align-items:center;gap:6px;}
  .diffchip .dl::before{content:"";width:12px;height:12px;border-radius:50%;background:var(--green);}
  .diffchip.medium .dl::before{background:var(--gold-deep);}
  .diffchip.hard .dl::before{background:var(--coral-deep);}
  .diffchip .dl small{font-weight:800;font-size:11px;color:#8AA0B4;text-transform:uppercase;letter-spacing:.08em;}
  .progress{display:block;height:7px;border-radius:99px;background:#E1EAEF;margin-top:6px;overflow:hidden;}
  .progress > i{display:block;height:100%;width:0;border-radius:99px;background:linear-gradient(90deg,var(--gold),var(--gold-deep));transition:width .5s cubic-bezier(.2,.9,.3,1);}
  .jar{display:flex;align-items:center;gap:5px;background:linear-gradient(160deg,#FFF3CE,#FFE49A);border-radius:15px;padding:8px 11px 8px 9px;flex:none;box-shadow:inset 0 -3px 0 rgba(229,164,19,.35);}
  .jar .star{font-size:20px;line-height:1;}
  .jar .count{font-family:'Fredoka';font-weight:700;font-size:20px;line-height:1;min-width:18px;text-align:center;}

  .prompt{align-self:center;background:var(--paper);border-radius:99px;padding:8px 18px;box-shadow:0 5px 0 var(--shadow);font-family:'Fredoka';font-weight:600;font-size:20px;color:var(--ink);display:flex;align-items:center;gap:8px;}
  .prompt .badge{font-family:'Fredoka';font-weight:700;font-size:22px;width:34px;height:34px;border-radius:12px;display:flex;align-items:center;justify-content:center;color:#fff;}
  .prompt.count .badge{background:linear-gradient(160deg,var(--green),var(--green-deep));}
  .prompt.add .badge{background:linear-gradient(160deg,var(--sky),var(--sky-deep));}
  .prompt.sub .badge{background:linear-gradient(160deg,var(--coral),var(--coral-deep));}

  .card{background:var(--paper);border-radius:26px;box-shadow:0 8px 0 var(--shadow);padding:14px 12px 12px;position:relative;overflow:hidden;}
  .tray{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:6px 12px;min-height:150px;padding:6px 2px 4px;}
  .group{display:flex;flex-wrap:wrap;gap:6px;justify-content:center;max-width:170px;}
  .plus{font-family:'Fredoka';font-weight:600;font-size:34px;color:#B9C6D1;padding:0 2px;}
  .coin{position:relative;filter:drop-shadow(0 3px 2px rgba(22,50,79,.22));animation:drop .45s cubic-bezier(.2,.9,.3,1) both;}
  .coin img{display:block;width:100%;height:100%;pointer-events:none;}
  @keyframes drop{from{opacity:0;transform:translateY(-16px) scale(.6);}to{opacity:1;transform:none;}}
  .coin.lit{animation:pop .4s ease;z-index:2;}
  @keyframes pop{0%{transform:scale(1);}40%{transform:scale(1.22);filter:drop-shadow(0 0 12px var(--gold));}100%{transform:scale(1);}}
  .coin.taken img{filter:grayscale(.9) brightness(1.05);opacity:.38;}
  .coin.taken::after{content:"";position:absolute;left:6%;top:50%;width:88%;height:12%;background:var(--coral-deep);border-radius:5px;transform:translateY(-50%) rotate(-28deg);box-shadow:0 1px 3px rgba(0,0,0,.3);animation:slash .3s ease both;}
  @keyframes slash{from{transform:translateY(-50%) rotate(-28deg) scaleX(0);}to{transform:translateY(-50%) rotate(-28deg) scaleX(1);}}
  .eq{font-family:'Fredoka';font-weight:600;font-size:46px;color:var(--sky);display:flex;align-items:center;gap:2px;padding-left:4px;}
  .qmark{width:60px;height:60px;border-radius:18px;background:linear-gradient(160deg,#EAF4FB,#D3EAF6);display:flex;align-items:center;justify-content:center;color:var(--sky);box-shadow:inset 0 -4px 0 rgba(121,205,234,.3);}

  .readout{margin-top:8px;display:flex;align-items:center;justify-content:center;gap:4px;background:var(--ink);border-radius:18px;color:#fff;padding:12px;min-height:64px;box-shadow:inset 0 3px 8px rgba(0,0,0,.35);}
  .readout .num{font-family:'Fredoka';font-weight:700;font-size:40px;letter-spacing:2px;line-height:1;color:var(--gold);text-shadow:0 0 12px rgba(255,201,60,.4);}
  .readout .num.placeholder{color:#5C7690;text-shadow:none;}
  .readout .cent{font-family:'Fredoka';font-weight:600;font-size:30px;color:#9FB6C9;}
  .readout.shake{animation:shake .4s;}
  @keyframes shake{0%,100%{transform:translateX(0);}20%{transform:translateX(-9px);}40%{transform:translateX(9px);}60%{transform:translateX(-6px);}80%{transform:translateX(6px);}}

  .reveal{position:absolute;left:12px;right:12px;bottom:12px;background:linear-gradient(160deg,var(--green),var(--green-deep));color:#fff;border-radius:18px;padding:14px;text-align:center;font-family:'Fredoka';font-weight:600;font-size:30px;line-height:1;box-shadow:0 6px 0 rgba(46,154,80,.45);transform:translateY(150%);transition:transform .45s cubic-bezier(.2,1.2,.3,1);}
  .reveal.show{transform:translateY(0);}

  .keyrow{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;background:var(--paper);border-radius:18px;padding:10px 8px;box-shadow:0 5px 0 var(--shadow);}
  .keyrow .lbl{width:100%;text-align:center;font-weight:800;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#8AA0B4;margin-bottom:2px;}
  .keycoin{display:flex;flex-direction:column;align-items:center;gap:1px;}
  .keycoin img{width:38px;height:38px;filter:drop-shadow(0 2px 1px rgba(22,50,79,.2));}
  .keycoin .v{font-family:'Fredoka';font-weight:600;font-size:15px;color:var(--ink);}
  .keycoin .n{font-size:10px;font-weight:700;color:#93A6B6;}

  .keypad{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;}
  .key{border:none;cursor:pointer;border-radius:20px;font-family:'Fredoka';font-weight:600;font-size:34px;padding:16px 0;color:var(--ink);background:var(--paper);box-shadow:0 6px 0 #D7C79A;transition:transform .06s,box-shadow .06s;display:flex;align-items:center;justify-content:center;}
  .key:active{transform:translateY(5px);box-shadow:0 1px 0 #D7C79A;}
  .key.help{grid-column:span 3;font-size:22px;color:#fff;background:linear-gradient(160deg,var(--purple),var(--purple-deep));box-shadow:0 6px 0 #4A2F9C;gap:8px;}
  .key.back{background:linear-gradient(160deg,var(--coral),var(--coral-deep));color:#fff;box-shadow:0 6px 0 #B33F24;}
  .key.enter{background:linear-gradient(160deg,var(--green),var(--green-deep));color:#fff;box-shadow:0 6px 0 #237A3E;font-size:24px;}

  .burst{position:fixed;left:50%;top:42%;pointer-events:none;z-index:50;}
  .bit{position:absolute;font-size:26px;animation:fly .95s ease-out forwards;}
  @keyframes fly{0%{opacity:1;transform:translate(0,0) rotate(0) scale(.4);}100%{opacity:0;transform:translate(var(--dx),var(--dy)) rotate(var(--dr)) scale(1.1);}}
  .cheer{position:fixed;left:0;right:0;top:34%;text-align:center;z-index:51;pointer-events:none;font-family:'Fredoka';font-weight:700;font-size:52px;color:#fff;text-shadow:0 4px 0 var(--green-deep),0 0 24px rgba(63,191,106,.6);opacity:0;transform:scale(.5);}
  .cheer.show{animation:cheer 1.1s cubic-bezier(.2,1.4,.3,1);}
  @keyframes cheer{0%{opacity:0;transform:scale(.4);}25%{opacity:1;transform:scale(1.1);}70%{opacity:1;transform:scale(1);}100%{opacity:0;transform:scale(1);}}

  @media (max-width:360px){.eq{font-size:38px;}.qmark{width:50px;height:50px;}.readout .num{font-size:34px;}.key{font-size:30px;padding:14px 0;}}
  @media (prefers-reduced-motion:reduce){*{animation-duration:.001s !important;transition-duration:.08s !important;}}
</style>
</head>
<body>

<!-- ============ HUB ============ -->
<div class="screen active" id="hub">
  <div class="hubhead">
    <div class="sun">☀️</div>
    <h1>Pick a game!</h1>
    <p>Tap a tile to play and learn.</p>
  </div>
  <div class="tiles">
    <button class="tile" id="tileMonier">
      <div class="tileart" id="monierArt"></div>
      <div class="tiletext"><span class="tt">The Monier</span><span class="ts">Count the money</span></div>
    </button>
    <div class="tile soon"><div class="tileart"><span class="soonart">🧩</span></div><div class="tiletext"><span class="tt">New game</span><span class="ts">Coming soon</span></div><span class="ribbon">Soon</span></div>
    <div class="tile soon"><div class="tileart"><span class="soonart">🔤</span></div><div class="tiletext"><span class="tt">New game</span><span class="ts">Coming soon</span></div><span class="ribbon">Soon</span></div>
    <div class="tile soon"><div class="tileart"><span class="soonart">🕐</span></div><div class="tiletext"><span class="tt">New game</span><span class="ts">Coming soon</span></div><span class="ribbon">Soon</span></div>
  </div>
</div>

<!-- ============ MODE SELECT ============ -->
<div class="screen" id="modeSelect">
  <div class="subhead">
    <button class="iconbtn" id="backHub" aria-label="Back to games">←</button>
    <div><div class="eyebrow">The Monier</div><div class="name">Choose a level</div></div>
  </div>
  <div class="modecards" id="modeCards"></div>
</div>

<!-- ============ GAME ============ -->
<div class="screen" id="game">
  <div class="topbar">
    <button class="iconbtn" id="homeBtn" aria-label="Home">🏠</button>
    <button class="diffchip" id="diffChip">
      <span class="dl"><small>Level</small> <span id="diffLabel">Easy</span></span>
      <span class="progress"><i id="progFill"></i></span>
    </button>
    <div class="jar"><span class="star">⭐</span><span class="count" id="starCount">0</span></div>
    <button class="iconbtn" id="muteBtn" aria-label="Toggle sound">🔊</button>
  </div>

  <div class="prompt count" id="prompt"><span class="badge" id="promptBadge">¢</span><span id="promptText">How much money?</span></div>

  <div class="card">
    <div class="tray" id="tray" aria-label="Coins to count"></div>
    <div class="readout" id="readout"><span class="num placeholder" id="answer">?</span><span class="cent">¢</span></div>
    <div class="reveal" id="reveal"></div>
  </div>

  <div class="keyrow" id="keyrow"><div class="lbl">Coin Key</div></div>

  <div class="keypad" id="keypad">
    <button class="key" data-k="1">1</button>
    <button class="key" data-k="2">2</button>
    <button class="key" data-k="3">3</button>
    <button class="key" data-k="4">4</button>
    <button class="key" data-k="5">5</button>
    <button class="key" data-k="6">6</button>
    <button class="key" data-k="7">7</button>
    <button class="key" data-k="8">8</button>
    <button class="key" data-k="9">9</button>
    <button class="key back" data-k="back" aria-label="Delete">⌫</button>
    <button class="key" data-k="0">0</button>
    <button class="key enter" data-k="enter">ENTER</button>
    <button class="key help" data-k="help">🔢 Count with me</button>
  </div>
</div>

<div class="burst" id="burst"></div>
<div class="cheer" id="cheer">🎉 YES!</div>

<script>
/* real coin photos (base64) */
const COIN_IMG = { penny:"data:image/png;base64,", nickel:"data:image/png;base64,", dime:"data:image/png;base64,", quarter:"data:image/png;base64," };
const COINS = {
  penny:  {value:1,  name:"Penny",   size:54},
  nickel: {value:5,  name:"Nickel",  size:60},
  dime:   {value:10, name:"Dime",    size:46},
  quarter:{value:25, name:"Quarter", size:70},
};
const COIN_ORDER=["quarter","dime","nickel","penny"];

/* difficulty modes */
const MODES = {
  easy:   {label:"Easy",   tag:"Count the coins",  ops:["count"],
           pool:[{t:"dime",min:0,max:2},{t:"nickel",min:0,max:2},{t:"penny",min:1,max:5}],
           coins:["dime","nickel","penny"], maxTotal:35},
  medium: {label:"Medium", tag:"Add & take away",  ops:["+","-"],
           pool:[{t:"quarter",min:0,max:1},{t:"dime",min:0,max:2},{t:"nickel",min:0,max:2},{t:"penny",min:0,max:4}],
           coins:["quarter","dime","nickel","penny"], maxTotal:65},
  hard:   {label:"Hard",   tag:"Bigger money math",ops:["+","-"],
           pool:[{t:"quarter",min:0,max:2},{t:"dime",min:0,max:3},{t:"nickel",min:0,max:3},{t:"penny",min:0,max:5}],
           coins:["quarter","dime","nickel","penny"], maxTotal:99},
};

let currentMode="easy", stars=0, input="", current=null, wrongCount=0, muted=false, locked=false;
const reduceMotion=matchMedia("(prefers-reduced-motion:reduce)").matches;
const $=s=>document.querySelector(s);
const randInt=(a,b)=>a+Math.floor(Math.random()*(b-a+1));
function shuffle(a){for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;}

/* ---------- views ---------- */
function showView(id){ document.querySelectorAll(".screen").forEach(s=>s.classList.toggle("active",s.id===id)); window.scrollTo(0,0); }

function buildHubArt(){
  $("#monierArt").innerHTML=["quarter","dime","penny"].map(t=>`<img src="${COIN_IMG[t]}" alt="">`).join("");
}
function buildModeCards(){
  const wrap=$("#modeCards"); wrap.innerHTML="";
  Object.entries(MODES).forEach(([key,m])=>{
    const b=document.createElement("button"); b.className="modecard "+key;
    const coins=m.coins.map(t=>`<img src="${COIN_IMG[t]}" alt="">`).join("");
    b.innerHTML=`<span class="mcoins">${coins}</span><span class="mtext"><span class="ml">${m.label}</span><span class="mt">${m.tag}</span></span><span class="go">▶</span>`;
    b.onclick=()=>startGame(key);
    wrap.appendChild(b);
  });
}

/* ---------- coin element ---------- */
function coinEl(type,px,taken){
  const d=document.createElement("div");
  d.className="coin"+(taken?" taken":"");
  d.style.width=px+"px"; d.style.height=px+"px";
  d.dataset.val=COINS[type].value; d.dataset.taken=taken?"1":"0";
  const img=document.createElement("img"); img.src=COIN_IMG[type]; img.alt=COINS[type].name; img.draggable=false;
  d.appendChild(img); return d;
}

/* ---------- generation ---------- */
function buildCoinSet(pool){
  let groups=[],coins=[],total=0;
  for(const p of pool){
    const n=randInt(p.min,p.max);
    if(n>0){ groups.push({type:p.t,count:n}); for(let i=0;i<n;i++) coins.push({type:p.t}); total+=n*COINS[p.t].value; }
  }
  groups.sort((a,b)=>COINS[b.type].value-COINS[a.type].value);
  return {groups,coins,total};
}
function typeSubtotals(coins){
  const sums={}; coins.forEach(c=>sums[c.type]=(sums[c.type]||0)+COINS[c.type].value);
  return COIN_ORDER.filter(t=>sums[t]).map(t=>sums[t]).join(" + ");
}
function makeProblem(){
  const m=MODES[currentMode];
  const op=m.ops[Math.floor(Math.random()*m.ops.length)];
  for(let tries=0;tries<60;tries++){
    if(op==="+"){
      const types=m.pool.map(p=>p.t);
      const two=shuffle([...types]).slice(0,2);
      const capOf=t=>Math.max(1,m.pool.find(p=>p.t===t).max);
      const g=two.map(t=>({type:t,count:randInt(1,capOf(t))}));
      const total=g.reduce((s,x)=>s+x.count*COINS[x.type].value,0);
      if(total<3||total>m.maxTotal) continue;
      g.sort((a,b)=>COINS[b.type].value-COINS[a.type].value);
      const coins=[]; g.forEach((gr,gi)=>{for(let i=0;i<gr.count;i++)coins.push({type:gr.type,group:gi,taken:false});});
      return {op,coins,answer:total,revealText:g.map(gr=>gr.count*COINS[gr.type].value).join(" + ")+" = "+total};
    }
    const set=buildCoinSet(m.pool);
    if(set.total<3||set.total>m.maxTotal||set.coins.length<2) continue;

    if(op==="count"){
      const coins=set.coins.map(c=>({type:c.type,group:0,taken:false}));
      coins.sort((a,b)=>COINS[b.type].value-COINS[a.type].value);
      return {op,coins,answer:set.total,revealText:typeSubtotals(coins)+" = "+set.total};
    }else{ /* subtraction */
      const coins=set.coins.map(c=>({type:c.type,group:0,taken:false}));
      coins.sort((a,b)=>COINS[b.type].value-COINS[a.type].value);
      const n=coins.length, k=randInt(1,Math.min(3,n-1));
      const idxs=shuffle([...Array(n).keys()]).slice(0,k);
      let takenVal=0; idxs.forEach(i=>{coins[i].taken=true;takenVal+=COINS[coins[i].type].value;});
      const ans=set.total-takenVal;
      return {op,coins,answer:ans,revealText:set.total+" − "+takenVal+" = "+ans};
    }
  }
  return {op:"count",coins:[{type:"dime",group:0,taken:false},{type:"penny",group:0,taken:false},{type:"penny",group:0,taken:false}],answer:12,revealText:"10 + 1 + 1 = 12"};
}

/* ---------- render ---------- */
function renderTray(){
  const tray=$("#tray"); tray.innerHTML=""; let lastG=null;
  current.coins.forEach((c,i)=>{
    if(current.op==="+" && lastG!==null && c.group!==lastG){
      const p=document.createElement("div"); p.className="plus"; p.textContent="+"; tray.appendChild(p);
    }
    if(lastG===null || c.group!==lastG){
      const g=document.createElement("div"); g.className="group"; g.dataset.g=c.group; tray.appendChild(g);
    }
    const el=coinEl(c.type,COINS[c.type].size,c.taken);
    el.style.animationDelay=(reduceMotion?0:i*0.05)+"s";
    tray.lastChild.appendChild(el);
    lastG=c.group;
  });
  const eq=document.createElement("div"); eq.className="eq"; eq.innerHTML='= <span class="qmark">?</span>'; tray.appendChild(eq);
}
function renderKey(){
  const row=$("#keyrow"); row.innerHTML='<div class="lbl">Coin Key</div>';
  MODES[currentMode].coins.forEach(t=>{
    const el=document.createElement("div"); el.className="keycoin";
    el.innerHTML=`<img src="${COIN_IMG[t]}" alt="${COINS[t].name}"><span class="v">${COINS[t].value}¢</span><span class="n">${COINS[t].name}</span>`;
    row.appendChild(el);
  });
}
function renderPrompt(){
  const p=$("#prompt");
  if(current.op==="count"){p.className="prompt count";$("#promptBadge").textContent="¢";$("#promptText").textContent="How much money?";}
  else if(current.op==="+"){p.className="prompt add";$("#promptBadge").textContent="+";$("#promptText").textContent="Add it up!";}
  else{p.className="prompt sub";$("#promptBadge").textContent="−";$("#promptText").textContent="How much is left?";}
}
function renderAnswer(){
  const a=$("#answer");
  if(input===""){a.textContent="?";a.classList.add("placeholder");}
  else{a.textContent=input;a.classList.remove("placeholder");}
}
function renderStatus(){
  $("#starCount").textContent=stars;
  const inMile=stars===0?0:((stars-1)%5+1);
  $("#progFill").style.width=(inMile/5*100)+"%";
}

/* ---------- sound ---------- */
let actx;
function beep(freq,dur=0.12,type="sine",vol=0.18,when=0){
  if(muted) return;
  try{actx=actx||new(window.AudioContext||window.webkitAudioContext)();
    const o=actx.createOscillator(),g=actx.createGain(),t=actx.currentTime+when;
    o.type=type;o.frequency.value=freq;g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(vol,t+0.02);g.gain.exponentialRampToValueAtTime(0.0001,t+dur);
    o.connect(g);g.connect(actx.destination);o.start(t);o.stop(t+dur+0.02);}catch(e){}
}
const sTap=()=>beep(560,0.06,"square",0.10);
const sWin=()=>[523,659,784,1046].forEach((f,i)=>beep(f,0.16,"sine",0.2,i*0.09));
const sTry=()=>{beep(300,0.16,"sine",0.16);beep(230,0.2,"sine",0.16,0.12);};
const sCount=()=>beep(700,0.08,"triangle",0.14);

/* ---------- flow ---------- */
function startGame(key){
  currentMode=key; stars=0; input=""; wrongCount=0; locked=false;
  const m=MODES[key];
  $("#diffChip").className="diffchip "+key;
  $("#diffLabel").textContent=m.label;
  showView("game");
  current=makeProblem();
  $("#reveal").classList.remove("show");
  renderStatus(); renderKey(); renderPrompt(); renderTray(); renderAnswer();
}
function newProblem(){
  input=""; wrongCount=0; locked=false;
  current=makeProblem();
  $("#reveal").classList.remove("show");
  renderStatus(); renderKey(); renderPrompt(); renderTray(); renderAnswer();
}
function submit(){ if(locked||input==="") return; if(parseInt(input,10)===current.answer) win(); else tryAgain(); }
function win(){
  locked=true; stars++; sWin();
  $("#reveal").textContent=current.revealText; $("#reveal").classList.add("show");
  const milestone=(stars%5===0);
  $("#cheer").textContent=milestone?"⭐ GREAT!":"🎉 YES!";
  celebrate(milestone); renderStatus();
  setTimeout(newProblem, reduceMotion?900:1800);
}
function tryAgain(){
  wrongCount++; sTry();
  const r=$("#readout"); r.classList.remove("shake"); void r.offsetWidth; r.classList.add("shake");
  input=""; renderAnswer();
  if(wrongCount>=2 && !locked) setTimeout(countWithMe,500);
}
function countWithMe(){
  if(locked) return; locked=true;
  const els=[...document.querySelectorAll("#tray .coin")].filter(e=>e.dataset.taken!=="1");
  let running=0,i=0; input=""; renderAnswer();
  const step=()=>{
    if(i>=els.length){
      input=String(current.answer); renderAnswer();
      $(".enter").animate?.([{transform:"scale(1)"},{transform:"scale(1.12)"},{transform:"scale(1)"}],{duration:600,iterations:2});
      locked=false; return;
    }
    running+=parseInt(els[i].dataset.val,10);
    els[i].classList.add("lit"); setTimeout(()=>els[i].classList.remove("lit"),420);
    input=String(running); renderAnswer(); sCount();
    i++; setTimeout(step, reduceMotion?250:640);
  };
  setTimeout(step,300);
}
function celebrate(big){
  const cheer=$("#cheer"); cheer.classList.remove("show"); void cheer.offsetWidth; cheer.classList.add("show");
  if(reduceMotion) return;
  const burst=$("#burst"), bits=["🪙","⭐","🎉","💛","🪙","⭐"], count=big?30:16;
  for(let i=0;i<count;i++){
    const b=document.createElement("span"); b.className="bit"; b.textContent=bits[i%bits.length];
    const ang=Math.random()*Math.PI*2, dist=90+Math.random()*(big?200:140);
    b.style.setProperty("--dx",Math.cos(ang)*dist+"px");
    b.style.setProperty("--dy",(Math.sin(ang)*dist-60)+"px");
    b.style.setProperty("--dr",(Math.random()*720-360)+"deg");
    b.style.animationDelay=(Math.random()*0.12)+"s";
    burst.appendChild(b); setTimeout(()=>b.remove(),1100);
  }
}

/* ---------- input ---------- */
function press(k){
  if(k==="help"){ if(!locked) countWithMe(); return; }
  if(locked) return;
  if(k==="enter"){ submit(); return; }
  sTap();
  if(k==="back"){ input=input.slice(0,-1); renderAnswer(); return; }
  if(input.length>=2) return;
  if(input==="" && k==="0") return;
  input+=k; renderAnswer();
}
$("#keypad").addEventListener("click",e=>{const b=e.target.closest(".key"); if(b) press(b.dataset.k);});
document.addEventListener("keydown",e=>{
  if(!$("#game").classList.contains("active")) return;
  if(e.key>="0"&&e.key<="9") press(e.key);
  else if(e.key==="Enter") press("enter");
  else if(e.key==="Backspace"){e.preventDefault(); press("back");}
  else if(e.key.toLowerCase()==="h") press("help");
});
$("#muteBtn").addEventListener("click",()=>{muted=!muted; $("#muteBtn").textContent=muted?"🔇":"🔊"; if(!muted) sTap();});
$("#tileMonier").addEventListener("click",()=>showView("modeSelect"));
$("#backHub").addEventListener("click",()=>showView("hub"));
$("#homeBtn").addEventListener("click",()=>showView("hub"));
$("#diffChip").addEventListener("click",()=>showView("modeSelect"));

/* init */
buildHubArt(); buildModeCards();
</script>
</body>
</html>
